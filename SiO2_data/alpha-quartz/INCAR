SYSTEM = Bulk SiO2

# Ionic Relaxation Settings
NSW    = 100        # Maximum number of ionic steps
IBRION = 2          # 2 = Conjugate gradient algorithm
ISIF   = 3          # 3 = Relax ions, cell volume, and cell shape (use ISIF = 2 for positions only)
EDIFFG = -0.02      # Stop relaxation when forces on all atoms < 0.02 eV/Å

# Electronic Minimization
PREC   = Accurate
ENCUT  = 500
EDIFF  = 1E-6

# Smearing (Gaussian smearing for insulator)
ISMEAR = 0
SIGMA  = 0.05

# Projection scheme (Auto is strongly recommended for >20 atoms)
LREAL  = Auto

# Output Control
LWAVE  = .FALSE.
LCHARG = .FALSE.

# Parallelization
NCORE  = 4