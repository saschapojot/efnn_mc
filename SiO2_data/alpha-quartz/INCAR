SYSTEM = Bulk SiO2 (3x3x3 supercell)

# Static Calculation
NSW    = 0
IBRION = -1

# Electronic Minimization
PREC   = Accurate
ENCUT  = 500
EDIFF  = 1E-6

# Smearing (Gaussian smearing for insulator)
ISMEAR = 0
